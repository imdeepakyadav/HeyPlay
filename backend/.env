# Database
MONGODB_URI=mongodb://localhost:27017/heyplay

# JWT Secret
JWT_SECRET=heyplay_super_secret_jwt_key_for_development_only

# Server Port
PORT=5000

# CORS Origins
CORS_ORIGINS=http://localhost:3000,exp://localhost:19000

# YouTube API (optional)
